  m_SharedData: {fileID: 11400000, guid: f62e1c1689fc64640bf6641ee5465afb, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 633425920
    m_Localized: "\uC5B4\uC11C \uC624\uAC8C, \uC5EC\uD589\uC790. \uC774 \uB9C8\uC744\uC5D4
      <wave>\uC190\uB2D8</wave>\uC774 \uB4DC\uBB3C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 683757568
    m_Localized: "\uCD0C\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 687951872
    m_Localized: "\uC774 \uB9C8\uC744\uC5D0\uB294 <color=#4aa3ff><sway>\uBB34\uC2A8
      \uC77C</sway></color>\uB85C \uC654\uB098?"
    m_Metadata:
      m_Items: []
  - m_Id: 687951873
    m_Localized: "\uB610 \uC654\uAD70. \uB354 \uAD81\uAE08\uD55C \uAC8C \uC788\uB098?"
    m_Metadata:
      m_Items: []
  - m_Id: 687951874
    m_Localized: "\uB3C4\uC6C0\uC774 \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 687951875
    m_Localized: "\uADF8\uB0E5 \uB458\uB7EC\uBCF4\uB294 \uC911\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 687951876
    m_Localized: "(\uB3C4\uC6C0\uC744 \uBC1B\uC558\uB2E4) \uAC10\uC0AC \uC778\uC0AC\uB97C
      \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 687951877
    m_Localized: "\uADF8\uB807\uB2E4\uBA74 \uC774 \uB3D9\uC804\uC744 \uBC1B\uAC8C.<pause=0.6>
      \uD070\uB3C8\uC740 \uC544\uB2C8\uC9C0\uB9CC \uB3C4\uC6C0\uC774 \uB420 \uAC78\uC138."
    m_Metadata:
      m_Items: []
  - m_Id: 687951878
    m_Localized: "\uBAB8\uC870\uC2EC\uD558\uAC8C. <shake>\uBC24</shake>\uC5D0\uB294
      \uC232\uC5D0 \uB098\uAC00\uC9C0 \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 687951879
    m_Localized: "\uC5B4\uB978\uC774 \uB41C \uB4A4, \uB098\uB294 <color=#4aa3ff><sway>\uD0DC\uC5B4\uB09C
      \uACF3\uC744 \uD5A5\uD55C \uADF8\uB9AC\uC6C0</sway></color>\uACFC <color=#4aa3ff><sway>\uB9C8\uC744\uC5D0
      \uC228\uACA8\uC9C4 \uBE44\uBC00\uC5D0 \uB300\uD55C \uD638\uAE30\uC2EC</sway></color>\uC744
      \uC548\uACE0 \uC5EC\uC815\uC744 \uB5A0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 687951880
    m_Localized: "\uD5C8\uD5C8, \uBCC4\uB9D0\uC744 \uB2E4 \uD558\uB294\uAD70. <rainbow>\uC0B4\uC544\uC11C
      \uB3CC\uC544\uC624\uAC8C\uB098.</rainbow>"
    m_Metadata:
      m_Items: []
  - m_Id: 687951881
    m_Localized: "\uBA48\uCDB0\uB77C. \uC5EC\uAE30\uC11C\uBD80\uD130\uB294 \uCD9C\uC785
      \uAE08\uC9C0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 687951882
    m_Localized: "\uACBD\uBE44\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 687951883
    m_Localized: "\uC774 \uC0AC\uC2E4\uC740 \uC774\uC57C\uAE30\uB97C \uAC74\uB108\uB6F8
      \uC218 \uC5C6\uB2E4. \uB05D\uAE4C\uC9C0 \uB4E4\uC5B4\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 687951884
    m_Localized: "...\uC54C\uACA0\uB098? \uADF8\uB7FC \uB3CC\uC544\uAC00\uB77C."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
